{
  "name": "@srd-mcp/dnd5e",
  "version": "0.1.0",
  "description": "D&D 5e SRD data and Gemini CLI sub-agent implementation",
  "author": "Mejelic mejelic@mattergen.io",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/yourusername/srd-mcp"
  },
  "keywords": [
    "dnd",
    "dungeons-and-dragons",
    "d&d",
    "srd",
    "gemini-cli",
    "sub-agent",
    "ttrpg",
    "rpg",
    "5e"
  ],
  "tasks": {
    "normalize": "deno run --allow-read --allow-write scripts/normalize/normalize-markdown.ts",
    "generate-glossary": "deno run --allow-read --allow-write scripts/generate-glossary.ts",
    "generate-index": "deno run --allow-read --allow-write scripts/generate-index.ts",
    "preprocess": "deno run --allow-read --allow-write scripts/preprocess.ts"
  },
  "imports": {
    "marked": "npm:marked@^14.1.3"
  },
  "compilerOptions": {
    "strict": true,
    "noImplicitAny": true,
    "strictNullChecks": true,
    "lib": ["deno.window", "deno.ns", "esnext"]
  }
}
