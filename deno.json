{
  "name": "@srd-mcp/dnd5e",
  "version": "0.1.0",
  "description": "Model Context Protocol (MCP) server providing access to the D&D 5e System Reference Document (SRD 5.2.1) with tools for spells, classes, species, backgrounds, feats, and game rules",
  "author": "Mejelic mejelic@mattergen.io",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/yourusername/srd-mcp"
  },
  "keywords": [
    "dnd",
    "dungeons-and-dragons",
    "d&d",
    "srd",
    "mcp",
    "model-context-protocol",
    "ttrpg",
    "rpg",
    "5e"
  ],
  "tasks": {
    "normalize": "deno run --allow-read --allow-write scripts/normalize/normalize-markdown.ts",
    "generate-glossary": "deno run --allow-read --allow-write scripts/generate-glossary.ts",
    "generate-index": "deno run --allow-read --allow-write scripts/generate-index.ts",
    "preprocess": "deno run --allow-read --allow-write scripts/preprocess.ts",
    "test": "deno test --allow-read tests/",
    "dev": "deno run --allow-read --allow-env src/server.ts",
    "start": "deno run --allow-read --allow-env src/server.ts"
  },
  "imports": {
    "@modelcontextprotocol/sdk/server/index.js": "npm:@modelcontextprotocol/sdk@1.0.4/server/index.js",
    "@modelcontextprotocol/sdk/server/stdio.js": "npm:@modelcontextprotocol/sdk@1.0.4/server/stdio.js",
    "@modelcontextprotocol/sdk/types.js": "npm:@modelcontextprotocol/sdk@1.0.4/types.js",
    "marked": "npm:marked@^14.1.3"
  },
  "compilerOptions": {
    "strict": true,
    "noImplicitAny": true,
    "strictNullChecks": true,
    "lib": ["deno.window", "deno.ns", "esnext"]
  }
}
